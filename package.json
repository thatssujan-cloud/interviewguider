{
  "name": "interview-copilot",
  "productName": "Interview Copilot",
  "private": true,
  "version": "1.0.0",
  "description": "Real-time AI Interview & Online Assessment (OA) Copilot desktop app — stealth overlay, live transcription, and streaming multimodal answers.",
  "author": "Interview Copilot Team",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,SERVER,ELECTRON -c yellow,blue,magenta \"vite\" \"wait-on tcp:5173 && npm run server\" \"wait-on tcp:3001 http://localhost:5173 && electron .\"",
    "server": "tsx watch server/index.ts",
    "server:once": "tsx server/index.ts",
    "build": "vite build && tsc -p tsconfig.electron.json && tsc -p tsconfig.server.json",
    "preview": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:all": "npm run build && electron-builder --mac --win"
  },
  "dependencies": {
    "@deepgram/sdk": "^3.9.0",
    "@google/genai": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "highlight.js": "^11.10.0",
    "marked-react": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "openai": "^6.49.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.9",
    "vite-plugin-electron": "^0.28.8",
    "wait-on": "^8.0.1",
    "ws": "^8.23.0"
  },
  "build": {
    "appId": "com.copilot.interview",
    "productName": "Interview Copilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "dist-server/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
