# ============================================================
# Interview Copilot — environment configuration
# Copy this file to `.env` and fill in your own keys.
# NEVER commit `.env` — keys live only in the backend proxy.
# ============================================================

# Google Gemini API key -> https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# AI provider fallback: set to "openai" to use OpenAI instead of Gemini
AI_PROVIDER=gemini
OPENAI_API_KEY=

# Deepgram (streaming speech-to-text) -> https://console.deepgram.com/keys
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# Project ID is required only for ephemeral scoped tokens (GET /api/stt-token)
DEEPGRAM_PROJECT_ID=your_deepgram_project_id_here

# Backend port (renderer + overlay expect 3001 by default)
PORT=3001
